from typing import Any

from matplotlib.backend_bases import _Backend, ShowBase
from matplotlib.figure import Figure
from matplotlib.backends.backend_webagg_core import (
    FigureCanvasWebAggCore,
    FigureManagerWebAgg as _FigureManagerWebAggCore,
    NavigationToolbar2WebAgg,
    TimerAsyncio as TimerAsyncio,
    TimerTornado as TimerTornado,
)

class NavigationIPy(NavigationToolbar2WebAgg): ...

class FigureManagerNbAgg(_FigureManagerWebAggCore):
    _toolbar2_class: type[NavigationIPy]
    ToolbarCls: type[NavigationIPy]
    def display_js(self) -> None: ...
    def reshow(self) -> None: ...
    @property
    def connected(self) -> bool: ...
    @classmethod
    def get_javascript(cls, stream: Any = ...) -> str: ...
    def clearup_closed(self) -> None: ...
    def remove_comm(self, comm_id: str) -> None: ...

class FigureCanvasNbAgg(FigureCanvasWebAggCore[NavigationIPy, FigureManagerNbAgg]): ...

class CommSocket:
    """Duck-typed WebSocket-like object for IPython kernel comm."""
    def __init__(self, manager: FigureManagerNbAgg) -> None: ...
    def is_open(self) -> bool: ...
    def on_close(self) -> None: ...
    def send_json(self, content: dict[str, Any]) -> None: ...
    def send_binary(self, blob: bytes) -> None: ...
    def on_message(self, message: str) -> None: ...

class _BackendNbAgg(_Backend[type[FigureCanvasNbAgg]]): ...

def connection_info() -> str: ...

# Names injected into the module namespace by ``@_Backend.export``.
backend_version: str
FigureCanvas = FigureCanvasNbAgg
FigureManager = FigureManagerNbAgg

def new_figure_manager(
    num: int | str, *args: Any, **kwargs: Any
) -> FigureManagerNbAgg: ...
def new_figure_manager_given_figure(
    num: int | str, figure: Figure
) -> FigureManagerNbAgg: ...
def draw_if_interactive() -> None: ...
def show(*, block: bool | None = ...) -> None: ...

class Show(ShowBase): ...
