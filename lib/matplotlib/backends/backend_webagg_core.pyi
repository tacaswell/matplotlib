from typing import Any

from matplotlib import _api
from matplotlib.backend_bases import (
    _Backend,
    FigureManagerBase,
    NavigationToolbar2,
    ShowBase,
    TimerBase,
)
from matplotlib.figure import Figure
from matplotlib.backends.backend_agg import FigureCanvasAgg

# tornado has no type stubs; objects from it are Any.

class TimerTornado(TimerBase):
    def __init__(self, *args: Any, **kwargs: Any) -> None: ...

class TimerAsyncio(TimerBase):
    def __init__(self, *args: Any, **kwargs: Any) -> None: ...

class FigureCanvasWebAggCore(
    FigureCanvasAgg[NavigationToolbar2WebAgg, FigureManagerWebAgg, TimerAsyncio]
):
    _timer_cls: type[TimerAsyncio]
    @_api.classproperty
    def supports_blit(cls) -> bool: ...
    def show(self) -> None: ...
    def set_image_mode(self, mode: str) -> None: ...
    def set_capture_scroll(self, capture: bool) -> None: ...
    def get_capture_scroll(self) -> bool: ...
    def get_diff_image(self) -> bytes: ...
    def handle_event(self, event: dict[str, Any]) -> None: ...
    # handle_* methods — each takes a single event dict:
    def handle_unknown_event(self, event: dict[str, Any]) -> None: ...
    def handle_ack(self, event: dict[str, Any]) -> None: ...
    def handle_draw(self, event: dict[str, Any]) -> None: ...
    def handle_button_press(self, event: dict[str, Any]) -> None: ...
    def handle_button_release(self, event: dict[str, Any]) -> None: ...
    def handle_dblclick(self, event: dict[str, Any]) -> None: ...
    def handle_figure_enter(self, event: dict[str, Any]) -> None: ...
    def handle_figure_leave(self, event: dict[str, Any]) -> None: ...
    def handle_motion_notify(self, event: dict[str, Any]) -> None: ...
    def handle_scroll(self, event: dict[str, Any]) -> None: ...
    def handle_key_press(self, event: dict[str, Any]) -> None: ...
    def handle_key_release(self, event: dict[str, Any]) -> None: ...
    def handle_toolbar_button(self, event: dict[str, Any]) -> None: ...
    def handle_refresh(self, event: dict[str, Any]) -> None: ...
    def handle_resize(self, event: dict[str, Any]) -> None: ...
    def handle_send_image_mode(self, event: dict[str, Any] | None) -> None: ...
    def handle_set_device_pixel_ratio(self, event: dict[str, Any]) -> None: ...
    def handle_set_dpi_ratio(self, event: dict[str, Any]) -> None: ...
    def send_event(self, event_type: str, **kwargs: Any) -> None: ...

class NavigationToolbar2WebAgg(NavigationToolbar2[FigureCanvasWebAggCore]):
    def set_history_buttons(self) -> None: ...

class FigureManagerWebAgg(FigureManagerBase[FigureCanvasWebAggCore]):
    _toolbar2_class: type[NavigationToolbar2WebAgg] | None
    ToolbarCls: type[NavigationToolbar2WebAgg]
    # resize adds a forward param not on the base.
    def resize(self, w: int, h: int, forward: bool = ...) -> None: ...
    def add_web_socket(self, web_socket: Any) -> None: ...
    def remove_web_socket(self, web_socket: Any) -> None: ...
    def handle_json(self, content: dict[str, Any]) -> None: ...
    def refresh_all(self) -> None: ...
    @classmethod
    def get_javascript(cls, stream: Any = ...) -> str: ...
    @classmethod
    def get_static_file_path(cls) -> str: ...

class _BackendWebAggCoreAgg(_Backend[type[FigureCanvasWebAggCore]]): ...

# Names injected into the module namespace by ``@_Backend.export``.
backend_version: str
FigureCanvas = FigureCanvasWebAggCore
FigureManager = FigureManagerWebAgg

def new_figure_manager(
    num: int | str, *args: Any, **kwargs: Any
) -> FigureManagerWebAgg: ...
def new_figure_manager_given_figure(
    num: int | str, figure: Figure
) -> FigureManagerWebAgg: ...
def draw_if_interactive() -> None: ...
def show(*, block: bool | None = ...) -> None: ...

class Show(ShowBase): ...
